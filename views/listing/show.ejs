<% layout("layouts/boilerplate") %>
  <script>
    const mapToken = "<%=process.env.MAP_TOKEN%>";
    const coordinates= <%- JSON.stringify(listing.geometry.coordinates)%>;
  </script>

  <body>
    <h3>Listing Details</h3>

    <div class="card mb-3">
      <div class="row g-0">
        <div class="col-md-4">
          <img src="<%=listing.image.url%>" class="img-fluid rounded-start show-img" alt="listing-img" />
        </div>
        <div class="col-md-8">
          <div class="card-body show-details">
            <h5 class="card-title">Title : <%= listing.title%>
            </h5>
            <div class="card-text" show-text>
              <br />
              <p><i>Owned by <%=listing.owner.username%></i></p>
              <p class="col-8"> Description : <%= listing.description%>
              </p>
              <p>Price : &#8377;<%=listing.price.toLocaleString("en-IN")%></p>
              <p>Location : <%= listing.location%>
              </p>
              <p>Country : <%=listing.country%>
              </p>
              <br />
            </div>
            <% let diffTime=Math.abs(new Date() - new Date(listing.updatedAt)); let diffDays=Math.floor(diffTime / (1000
              * 60 * 60 * 24)); let timeMessage="" ; if (diffDays===0) { timeMessage="Updated today" ; } else if
              (diffDays===1) { timeMessage="Updated 1 day ago" ; } else { timeMessage=`Updated ${diffDays} days ago`; }
              %>
              <p class="card-text">
                <small class="text-body-secondary">
                  <%= timeMessage %>
                </small>
              </p>
          </div>
        </div>
      </div>
    </div>

    <br /><br />
    <%if(currUser && currUser._id.equals(listing.owner._id)){%>
      <div class="show-btns offset-2">
        <a href="/listings/<%=listing._id%>/edit" class="btn create-btn btn-dark btn-md">
          Edit
        </a>
        <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
          <button class="btn btn-dark create-btn">Delete</button>
        </form>
      </div>
      <%}%>

        <div class="col-8 mb-3 mt-3">
          <h4 class="mb-3">Leave a Review</h4>
          <% if(currUser){%>
            <form action="/listings/<%=listing._id%>/reviews" method="post" novalidate class="needs-validation">

              <div class="mb-1">
                <label for="rating" class="form-label">Rating </label>
                <fieldset class="starability-fade">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                    aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mb-3">
                <label for="coment" class="form-label">Coments</label>
                <textarea name="review[coment]" id="coment" col="30" row="5" class="form-control"
                  placeholder="Add coment" required></textarea>
                <div class="invalid-feedback">please add some coment</div>
              </div>

              <button class="btn btn-outline-dark">Submit</button>
            </form>
            <%}%>
        </div>

        <hr />
        <br />

        <h4 class="mb-3">ALL REVIEW</h4>

        <div class="row">
          <% for (review of listing.reviews){ %>
            <div class="card review-card col-3 mb-4 ms-3">
              <div class="card-body">
                <h5 class="card-title">
                  @<%= review.createdBy.username %>
                </h5>
                <p class="starability-result card-text " data-rating="<%= review.rating %>"></p>
                <p class="card-text">
                  <%=review.coment%>
                </p>
              </div>

              <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">

                <button class="btn btn-sm btn-danger mt-3 mb-3">Delete</button>

              </form>
            </div>

            <% }%>

        </div>
        <h3>Where you'll be</h3>
        <div class="row mt-2 mb-5">
          <div class="col-md-8 offset-md-2 col-12 ">
            <div id="map"></div>
          </div>
        </div>
        <script src="/js/map.js"></script>

  </body>